# Устанавливаем окончания строк для текстовых файлов
* text=auto

# Специфичные правила для различных типов файлов
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Конфигурационные файлы
.gitignore text eol=lf
.gitattributes text eol=lf
*.config.js text eol=lf
*.config.ts text eol=lf

# Бинарные файлы (не изменять окончания строк)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

